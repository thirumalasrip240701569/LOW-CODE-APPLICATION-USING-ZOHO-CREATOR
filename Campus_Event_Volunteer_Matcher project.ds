		workflow
		{
		form
		{
			auto_set_registration_status as "Auto-Set Registration Status"
			{
				type =  form
				form = volunteer_registration

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Set the registration_status field to Active upon successful submission
										input.registration_status = "Active";
										// Log the update for verification
										info "Registration status updated to Active for volunteer: " + input.full_name.first_name;
						)
					}
				}

			}
			validate_volunteer_skills_match as "Validate Volunteer Skills Match"
			{
				type =  form
				form = volunteer_applications

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the volunteer registration record based on the lookup field
										volunteerRecord = volunteer_registration[ID == input.volunteer];
										// Fetch the volunteer requirement record based on the lookup field
										volRequirementRecord = volunteer_requirements[ID == input.volunteer_requirement];
										// Get the required skills from the volunteer requirement
										requiredSkillsList = volRequirementRecord.required_skills;
										// Get the skills from the volunteer registration
										volunteerSkillsList = volunteerRecord.skills;
										// Check if there are any required skills
										if(!requiredSkillsList.isEmpty())
										{
											// Flag to track if any required skill is missing
											skillsMatch = false;
											// Iterate through each required skill
											for each  requiredSkill in requiredSkillsList
											{
												// Check if the volunteer has this required skill
												if(volunteerSkillsList.contains(requiredSkill))
												{
													skillsMatch = true;
													break;
												}
											}
											// If no required skills match, cancel submission
											if(!skillsMatch)
											{
												alert "Your skills do not match the event requirements. Please ensure you have at least one of the required skills: " + requiredSkillsList.toString();
												cancel submit;
											}
										}
						)
					}
				}

			}
			notify_volunteer_on_approval as "Notify Volunteer on Approval"
			{
				type =  form
				form = volunteer_applications

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the volunteer record using the lookup field
										volunteerRecord = volunteer_registration[ID == input.volunteer];
										// Check if volunteer email exists
										if(volunteerRecord.college_email.isNull())
										{
											info "Volunteer email not found";
										}
										else
										{
											// Send email notification to the volunteer
											sendmail
											[
												from :zoho.loginuserid
												to :volunteerRecord.college_email
												subject :"Your Volunteer Application Has Been Approved"
												message :"Dear " + volunteerRecord.full_name.first_name + ",\n\nYour application for the event has been approved. We look forward to seeing you there!\n\nBest regards,\nEvent Organizing Team"
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			event_reminder_before_deadline as "Event Reminder Before Deadline"
			{
				type =  schedule
				form = event_registration
					status = inactive
				start = registration_deadline at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch the event registration record from input context
										eventName = input.event_name;
										deadlineDate = input.registration_deadline;
										eventID = input.ID;
										// Calculate the reminder date (one day before deadline)
										reminderDate = deadlineDate.subDay(1);
										// Check if today is the reminder date
										if(zoho.currentdate == reminderDate)
										{
											// Fetch all volunteer requirements for this event
											volunteerRequirements = volunteer_requirements[event.ID == eventID && requirement_status == "Open"];
											// Iterate through each volunteer requirement
											for each  requirement in volunteerRequirements
											{
												// Fetch all volunteer applications for this requirement
												volunteerApplications = volunteer_applications[volunteer_requirement.ID == requirement.ID && application_status == "Pending"];
												// Iterate through each volunteer application
												for each  application in volunteerApplications
												{
													// Get volunteer details from the lookup
													volunteerRecord = volunteer_registration[ID == application.volunteer.ID];
													// Get volunteer email
													volunteerEmail = volunteerRecord.college_email;
													// Get volunteer name
													volunteerName = volunteerRecord.full_name.first_name;
													// Send email reminder
													sendmail
													[
														from :zoho.loginuserid
														to :volunteerEmail
														subject :"Reminder: Volunteer Registration Deadline for " + eventName
														message :"Dear " + volunteerName + ",\n\nThis is a friendly reminder that the registration deadline for the event \"" + eventName + "\" is tomorrow (" + reminderDate.toString() + ").\n\nPlease complete your volunteer application before the deadline.\n\nBest regards,\nCampus Event Team"
													]
												}
											}
										}
					)
					}
				}
			}
		}


