 application "copy of Campus Event Volunteer Matcher"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form event_registration
		{
			displayname = "Event Registration"
			success message = "Event Registration Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			event_name
			(
    			type = text
				displayname = "Event Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			organizing_club
			(
    			type = text
				displayname = "Organizing Club"
	 			row = 1
	 			column = 1   
				width = medium
			)
			event_description
			(
    			type = textarea
				displayname = "Event Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			event_category
			(
				type = picklist
				displayname = "Event Category"
				values = {"Seminar","Symposium","Technical","Workshop","Cultural","Sports","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			event_date
			(
    			type = date
				displayname = "Event Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			event_venue
			(
    			type = text
				displayname = "Event Venue"
	 			row = 1
	 			column = 1   
				width = medium
			)
			registration_deadline
			(
    			type = date
				displayname = "Registration Deadline"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			event_status
			(
				type = picklist
				displayname = "Event Status"
				values = {"Upcoming","Completed","Ongoing","Cancelled"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form volunteer_applications
		{
			displayname = "Volunteer Applications"
			success message = "Volunteer Applications Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			volunteer
			(
				type = picklist	
				displayname = "Volunteer"
				values  = volunteer_registration.ID
    			displayformat = [full_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			volunteer_requirement
			(
				type = picklist	
				displayname = "Volunteer Requirement"
				values  = volunteer_requirements.ID
    			displayformat = [number_of_volunteers_required]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			application_date
			(
    			type = date
				displayname = "Application Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			why_do_you_want_to_volunteer
			(
    			type = textarea
				displayname = "Why Do You Want To Volunteer?"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			application_status
			(
				type = picklist
				displayname = "Application Status"
				values = {"Approved","Completed","Rejected","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			organizer_remarks
			(
    			type = textarea
				displayname = "Organizer Remarks"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Application Received","Under Review","Application Rejected","Approved","Rejected","Pending Additional Information","Onboarding Scheduled","Active Volunteer","Volunteer Completed","Volunteer Withdrawn","Application Closed"}
			}
		}
		form volunteer_registration
		{
			displayname = "Volunteer Registration"
			success message = "Volunteer Registration Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			full_name
			(
    			type = name
				displayname = "Full Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			student_register_number
			(
    			type = text
				displayname = "Student Register Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			college_email
			(
    			type = email
				displayname = "College Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			department
			(
				type = picklist
				displayname = "Department"
				values = {"Civil","CSE","EEE","ECE","Mechanical","IT","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			year_of_study
			(
				type = picklist
				displayname = "Year of Study"
				values = {"4th Year","3rd Year","2nd Year","1st Year"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			skills
			(
				type = list	
				displayname = "Skills"
				values = {"Design","Photography","Video Editing","Public Relations","Social Media","Technical Support","Event Management","Stage Management","Content Writing","Registration Management"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			interests
			(
				type = list	
				displayname = "Interests"
				values = {"Design","Photography","Video Editing","Public Relations","Social Media","Technical Support","Event Management","Stage Management","Content Writing","Registration Management"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			availability
			(
				type = picklist
				displayname = "Availability"
				values = {"Weekends","Weekdays","Both"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			registration_status
			(
				type = radiobuttons
				displayname = "Registration Status"
				values = {"Active","Inactive"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form volunteer_requirements
		{
			displayname = "Volunteer Requirements"
			success message = "Volunteer Requirements Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			event
			(
				type = picklist	
				displayname = "Event"
				values  = event_registration.ID
    			displayformat = [event_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			volunteer_role
			(
				type = picklist
				displayname = "Volunteer Role"
				values = {"Design","Photography","Video Editing","Public Relations","Social Media","Technical Support","Event Management","Stage Management","Content Writing","Registration Management"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			required_skills
			(
				type = list	
				displayname = "Required Skills"
				values = {"Design","Photography","Video Editing","Public Relations","Social Media","Technical Support","Event Management","Stage Management","Content Writing","Registration Management"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			number_of_volunteers_required
			(
				type = number
				displayname = "Number of Volunteers Required"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			reporting_time
			(
    			type = datetime
				displayname = "Reporting Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			additional_instructions
			(
    			type = textarea
				displayname = "Additional Instructions"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			requirement_status
			(
				type = picklist
				displayname = "Requirement Status"
				values = {"Closed","Open","Filled"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Requirement Created","Volunteers Assigned","Requirement Cancelled","Assignment Pending Approval","Assignment Approved","Assignment Rejected","Volunteers Notified","Event Completed","Volunteer Withdrawn"}
			}
		}
	}
	reports
	{
		list volunteer_applications_Report
		{
			displayName = "All Volunteer Applications"
			show all rows from volunteer_applications    
			(
				volunteer as "Volunteer"
				volunteer_requirement as "Volunteer Requirement"
				application_date as "Application Date"
				why_do_you_want_to_volunteer as "Why Do You Want To Volunteer?"
				application_status as "Application Status"
				organizer_remarks as "Organizer Remarks"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (application_status == "Approved")
				fields = [application_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (application_status == "Pending")
				fields = [application_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (application_status == "Rejected")
				fields = [application_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban volunteer_applications_by_application_status
		{
			displayName = "Application Statuses"
			show all rows from volunteer_applications    
			(
				volunteer as "Volunteer"
				volunteer_requirement as "Volunteer Requirement"
				application_date as "Application Date"
				why_do_you_want_to_volunteer as "Why Do You Want To Volunteer?"
				application_status as "Application Status"
				organizer_remarks as "Organizer Remarks"
			)
			options
			(
	 			display field = application_status
	 		)
		}
		list volunteer_requirements_Report
		{
			displayName = "All Volunteer Requirements"
			show all rows from volunteer_requirements    
			(
				event as "Event"
				volunteer_role as "Volunteer Role"
				required_skills as "Required Skills"
				number_of_volunteers_required as "Number of Volunteers Required"
				reporting_time as "Reporting Time"
				additional_instructions as "Additional Instructions"
				requirement_status as "Requirement Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (requirement_status == "Closed")
				fields = [requirement_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (requirement_status == "Filled")
				fields = [requirement_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (requirement_status == "Open")
				fields = [requirement_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban volunteer_requirements_by_volunteer_role
		{
			displayName = "Volunteer Roles"
			show all rows from volunteer_requirements    
			(
				event as "Event"
				volunteer_role as "Volunteer Role"
				required_skills as "Required Skills"
				number_of_volunteers_required as "Number of Volunteers Required"
				reporting_time as "Reporting Time"
				additional_instructions as "Additional Instructions"
				requirement_status as "Requirement Status"
			)
			options
			(
	 			display field = volunteer_role
	 		)
		}
		list volunteer_registration_Report
		{
			displayName = "All Volunteer Registrations"
			show all rows from volunteer_registration    
			(
				full_name  as "Full Name"
				student_register_number as "Student Register Number"
				college_email as "College Email"
				department as "Department"
				year_of_study as "Year of Study"
				skills as "Skills"
				interests as "Interests"
				availability as "Availability"
				contact_number as "Contact Number"
				registration_status as "Registration Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (year_of_study == "1st Year")
				fields = [year_of_study]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (year_of_study == "2nd Year")
				fields = [year_of_study]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban volunteer_registration_by_department
		{
			displayName = "Departments"
			show all rows from volunteer_registration    
			(
				full_name  as "Full Name"
				student_register_number as "Student Register Number"
				college_email as "College Email"
				department as "Department"
				year_of_study as "Year of Study"
				skills as "Skills"
				interests as "Interests"
				availability as "Availability"
				contact_number as "Contact Number"
				registration_status as "Registration Status"
			)
			options
			(
	 			display field = department
	 		)
		}
		list event_registration_Report
		{
			displayName = "All Event Registrations"
			show all rows from event_registration    
			(
				event_name as "Event Name"
				organizing_club as "Organizing Club"
				event_description as "Event Description"
				event_category as "Event Category"
				event_date as "Event Date"
				event_venue as "Event Venue"
				registration_deadline as "Registration Deadline"
				event_status as "Event Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (event_status == "Completed")
				fields = [event_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (event_status == "Ongoing")
				fields = [event_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban event_registration_by_event_category
		{
			displayName = "Event Categories"
			show all rows from event_registration    
			(
				event_name as "Event Name"
				organizing_club as "Organizing Club"
				event_description as "Event Description"
				event_category as "Event Category"
				event_date as "Event Date"
				event_venue as "Event Venue"
				registration_deadline as "Registration Deadline"
				event_status as "Event Status"
			)
			options
			(
	 			display field = event_category
	 		)
		}
	}
	pages
	{
		page DashBoard
		{
